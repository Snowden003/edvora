{
  "id": "com.edvora.app",
  "name": "Edvora - سامانه آموزش و یادگیری آنلاین",
  "short_name": "Edvora",
  "description": "سامانه جامع آموزشی ادورا - دسترسی اختصاصی به داشبورد دانش‌آموزان و اساتید، دوره‌ها، کلاس‌های آنلاین و آزمون‌ها",
  "lang": "fa",
  "dir": "rtl",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "categories": [
    "education",
    "productivity"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://edvoratech.com/manifest.json"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope": "/"
    },
    "new_tab_button": {
      "url": "/app"
    }
  },
  "note_taking": {
    "new_note_url": "/app?action=new-note"
  },
  "scope_extensions": [
    {
      "origin": "https://edvoratech.com"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+edvora",
      "url": "/app?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/app",
      "name": "Course Material",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "text/plain": [".txt"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "/app",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Edvora Courses",
      "short_name": "Edvora",
      "description": "دسترسی سریع به دوره‌ها و اعلانات فعال ادورا",
      "tag": "edvora-widget",
      "template": "edvora-widget",
      "ms_ac_template": "widgets/edvora.json",
      "data": "/api/widget-data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/desktop-1.png",
          "sizes": "1376x768",
          "label": "Edvora Widget"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1376x768",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Edvora Platform Desktop Dashboard"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "768x1376",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Edvora Platform Mobile App"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "داشبورد دانشجویی",
      "short_name": "دانش‌آموز",
      "description": "دسترسی مستقیم به دوره‌ها و کلاس‌های دانش‌آموز",
      "url": "/student/dashboard?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "داشبورد استاد",
      "short_name": "اساتید",
      "description": "مدیریت کلاس‌ها، تکالیف و جلسات آموزشی استاد",
      "url": "/teacher/dashboard?source=pwa_shortcut",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}